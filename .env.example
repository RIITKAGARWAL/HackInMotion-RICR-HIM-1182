# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# Auth — REQUIRED. The server refuses to start if this is missing.
# Use a long random value, e.g. `openssl rand -hex 48` or `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_jwt_secret_key_here

# CORS — comma-separated list of allowed browser origins.
# No wildcard: requests from unlisted origins are rejected with 403.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# Database Settings (Neon / PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require
PGHOST=ep-sample-host.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=username
PGPASSWORD=your_database_password_here
PGPORT=5432

# Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379